# Chaves de API do servidor. Copie este arquivo para .env (que não vai para o Git) e troque os valores.
# Sem o .env, valem as chaves de demonstração (as mesmas que aparecem na documentação).
#
# Atenção: a Rastreabilidade grava as chaves dela no banco na primeira vez que sobe. Para trocar depois,
# use a tela Cadastros -> Integrações (Gerar nova chave) e atualize aqui o valor usado pelos outros sistemas.

# Chaves que a Qualidade e o Dashboard usam para chamar a Rastreabilidade
RASTREABILIDADE_CHAVE_QUALIDADE=amt_demo_qualidade
RASTREABILIDADE_CHAVE_DASHBOARD=amt_demo_dashboard
RASTREABILIDADE_CHAVE_MANUTENCAO=amt_demo_manutencao
# Chave da rota de máquinas/IoT da Rastreabilidade
RASTREABILIDADE_CHAVE_IOT=amatech-iot-demo

# Chave de cada API (quem chama envia no cabeçalho X-API-Key)
QUALIDADE_API_KEY=amatech-qualidade-demo
MANUTENCAO_API_KEY=amatech-manutencao-demo
DASHBOARD_API_KEY=amatech-dashboard-demo
