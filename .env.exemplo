# Configuracoes do ecossistema AMATECH Smart Factory.
# Copie este arquivo para .env e configure os valores para o seu ambiente.
# O docker stack deploy NAO le o .env sozinho: carregue antes com  set -a; . ./.env; set +a
# (no Portainer, cadastre as mesmas variaveis em "Environment variables" da stack).

# ================================================================== ERP (producao: docker-compose.yml)
# API única + Angular + PostgreSQL. Guia: SERVIDOR_ERP.md
# Os valores marcados como OBRIGATÓRIO não têm padrão: o deploy recusa subir sem eles.

# Domínio do ERP (o mesmo do sistema antigo, que ele substitui). OBRIGATÓRIO.
ERP_HOST=amatech.automakad.com.br

# Senha do PostgreSQL do ERP. Use só letras e números (ela vai dentro de uma URL). OBRIGATÓRIO.
#   gerar: python -c "import secrets; print(secrets.token_hex(24))"
ERP_DB_SENHA=troque-esta-senha

# Segredo que assina os tokens de login (JWT). Gere um novo; trocar derruba as sessões abertas. OBRIGATÓRIO.
#   gerar: python -c "import secrets; print(secrets.token_urlsafe(48))"
ERP_JWT_SEGREDO=troque-este-segredo

# Chave das máquinas/IoT (X-API-Key em /api/ras/maquinas/status). Não pode ser a de demonstração. OBRIGATÓRIO.
ERP_CHAVE_MAQUINAS=troque-esta-chave

# 1 = povoa os dados de demonstração na primeira subida (só para testar). Deixe 0 para migrar os dados reais.
ERP_SEED_DEMO=0

# Imagens publicadas pelo workflow erp-imagens.yml (troque latest por sha-xxxxxxx para fixar uma versão).
ERP_IMAGEM_API=ghcr.io/radierfalk/amatech-smart-factory-api:latest
ERP_IMAGEM_WEB=ghcr.io/radierfalk/amatech-smart-factory-web:latest

# Opcionais: duração do login em minutos (padrão 480 = um turno) e processos da API (padrão 2).
# ERP_JWT_EXPIRACAO_MINUTOS=480
# ERP_WORKERS=2

# ================================================================== Sistema antigo (docker-compose.legado.yml)
# Só para voltar atrás na virada. Guia: SERVIDOR.md
#
# Seguranca por perimetro de rede (Abordagem 1):
# - Entre conteineres (rede VandreNet) ou em localhost, as chamadas dispensam a chave X-API-Key.
# - Quem chega pelo Traefik (navegador ou programa fora do servidor) PRECISA da chave.

# Dominio publico apontado no Traefik (Host)
AMATECH_HOST=amatech.automakad.com.br

# Imagem Docker gerada pelo pipeline do GitHub Actions (GHCR)
AMATECH_IMAGE=ghcr.io/radierfalk/amatech-smart-factory:latest

# Chaves das APIs (X-API-Key). Troque as de demonstracao antes de publicar.
QUALIDADE_API_KEY=amatech-qualidade-demo
MANUTENCAO_API_KEY=amatech-manutencao-demo
DASHBOARD_API_KEY=amatech-dashboard-demo
# As chaves da Rastreabilidade ficam no banco dela (tela Cadastros -> Integracoes).
# So preencha se ativar RASTREABILIDADE_EXIGIR_CHAVE=1:
# RASTREABILIDADE_CHAVE_QUALIDADE=amt_demo_qualidade
# RASTREABILIDADE_CHAVE_DASHBOARD=amt_demo_dashboard

# Opcionais (Seguranca Estrita): para exigir a chave tambem na rede interna, defina 1:
# QUALIDADE_EXIGIR_CHAVE=1
# MANUTENCAO_EXIGIR_CHAVE=1
# DASHBOARD_EXIGIR_CHAVE=1
# RASTREABILIDADE_EXIGIR_CHAVE=1
