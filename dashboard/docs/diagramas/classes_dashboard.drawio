fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="30" y="1033" width="1260" height="54" as="geometry"/></mxCell><mxCell id="c78" value="&lt;b&gt;Legenda:&lt;/b&gt; &amp;nbsp;&lt;font color=&quot;#B8860B&quot;&gt;■&lt;/font&gt; Serviço &amp;nbsp; &lt;font color=&quot;#B85450&quot;&gt;■&lt;/font&gt; Acesso ao banco &amp;nbsp; &lt;font color=&quot;#5B84B8&quot;&gt;■&lt;/font&gt; Cadastro &amp;nbsp; &lt;font color=&quot;#8E6BA8&quot;&gt;■&lt;/font&gt; Acesso &amp;nbsp; &lt;font color=&quot;#C9A227&quot;&gt;■&lt;/font&gt; Importação &amp;nbsp; &lt;font color=&quot;#5E9E4F&quot;&gt;■&lt;/font&gt; Evento da linha &amp;nbsp; - - &amp;gt; Dependência (usa) &amp;nbsp; ◆── Composição &amp;nbsp; + público &amp;nbsp; - privado" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="30" y="1099" width="1260" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>