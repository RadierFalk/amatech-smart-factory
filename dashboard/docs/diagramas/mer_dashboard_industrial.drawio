<mxfile host="app.diagrams.net"><diagram name="MER" id="MER"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2111" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="MER — Dashboard Industrial (AMATECH Smart Factory)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c4" value="SQLite · 17 tabelas · PK = chave primária · FK = chave estrangeira · || = um (obrigatório) · o| = um (opcional) · o&amp;lt; = zero ou muitos&lt;br&gt;Cor da linha = tabela de origem (a mesma cor marca o PK dessa tabela) · Linhas tracejadas = origem opcional em planilha importada&lt;br&gt;&lt;b&gt;Nota:&lt;/b&gt; todas as tabelas de evento, a meta e a importação guardam o usuário que registrou o dado (campo registrado_por → usuario); essas linhas foram omitidas para facilitar a leitura." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1300" height="64" as="geometry"/></mxCell><mxCell id="c5" value="turno" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=28;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#6c8ebf;fontColor=#ffffff;swimlaneFillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="33" y="1179" width="169" height="134" as="geometry"/></mxCell><mxCell id="c6" value="PK id_turno: integer" style="text;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;fontSize=11;fillColor=#1F77B4;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="c5"><mxGeometry x="0" y="28" width="169" height="20" as="geometry"/></mx