# Copie para backend/.env (o .env nunca vai para o Git).
AMATECH_DATABASE_URL=postgresql+psycopg://amatech:amatech@localhost:5432/amatech
# Gere um segredo com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
AMATECH_JWT_SEGREDO=dev-inseguro-troque-em-producao-0123456789
AMATECH_JWT_EXPIRACAO_MINUTOS=480
AMATECH_CORS_ORIGENS=["http://localhost:4200"]
AMATECH_AMBIENTE=desenvolvimento
# Banco usado pelos testes (é APAGADO e recriado a cada execução; nunca aponte para o banco real)
AMATECH_TEST_DATABASE_URL=postgresql+psycopg://amatech:amatech@localhost:5432/amatech_testes
# Chave que as máquinas/IoT mandam em X-API-Key para /api/ras/maquinas/status (troque em produção)
AMATECH_CHAVE_MAQUINAS=amatech-iot-demo
